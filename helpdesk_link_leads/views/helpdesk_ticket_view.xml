<odoo>

    <record id="helpdesk_activity_plan_action_lead" model="ir.actions.act_window">
        <field name="name">Ticket Plans</field>
        <field name="res_model">mail.activity.plan</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="mail.mail_activity_plan_view_search"/>
        <field name="context">{'default_res_model': 'helpdesk.ticket'}</field>
        <field name="domain">[('res_model', '=', 'helpdesk.ticket')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Ticket Activity Plan
            </p>
            <p>
                Activity plans are used to assign a list of activities in just a few clicks
                (e.g. "Demo Preparation Process", "Qualification", ...)
            </p>
        </field>
    </record>
    <menuitem
        id="mail_activity_plan_menu_config_lead"
        name="Activity Plans"
        parent="helpdesk_mgmt.helpdesk_ticket_config_main_menu"
        action="helpdesk_activity_plan_action_lead"
        sequence="11"
    />
    
    <record id="helpdesk_ticket_view_search" model="ir.ui.view">
        <field name="name">helpdesk.ticket.view.search</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_mgmt.helpdesk_ticket_view_search" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="lead_ids" groups="sales_team.group_sale_salesman" />
            </field>
        </field>
    </record>
    <record id="ticket_view_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.view.form</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_mgmt.ticket_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    class="oe_highlight"
                    type="action"
                    name="%(helpdesk_ticket_create_lead_action)d"
                    icon="fa-arrow-right"
                    string="Convert to opportunity"
                    groups="sales_team.group_sale_salesman"
                />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    class="oe_stat_button"
                    icon="fa-star"
                    type="object"
                    name="action_open_leads"
                    groups="sales_team.group_sale_salesman"
                >
                    <field
                        string="Opportunity(ies)"
                        name="lead_count"
                        widget="statinfo"
                    />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
